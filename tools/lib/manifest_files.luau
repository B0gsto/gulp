--!strict
-- Where the asset manifest lives, and the text of its run-time copy (docs/07, sections 1.3 and
-- 16). Shared by tools/gen/manifest.luau, tools/release_check.luau and their specs.
local ManifestFiles = {}

ManifestFiles.CSV = "assets/manifest.csv"
ManifestFiles.MODULE = "src/shared/Config/AssetManifest.luau"
ManifestFiles.ASSET_LIST = "docs/07-asset-list.md"

--- The source of Config/AssetManifest.luau for the manifest text `csv`: the CSV itself as one
--- long string, which Data/Manifest parses at run time.
function ManifestFiles.moduleSource(csv: string): string
	if string.find(csv, "]==]", 1, true) then
		error("manifest text must not contain ]==]", 0)
	end
	return table.concat({
		"--!strict",
		"-- GENERATED by `lune run tools/gen/manifest` from assets/manifest.csv. Do not edit: change the",
		"-- CSV and run the generator. Data/Manifest parses this text (docs/07, sections 1.3 and 16).",
		"-- Asset IDs live here, under Config, never in Data/Generated (docs/09, section 3.2).",
		"return [==[",
		csv .. "]==]",
		"",
	}, "\n")
end

return ManifestFiles
