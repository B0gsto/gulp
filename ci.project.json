// Rojo: complete code-only place for CI (docs/09-technical-architecture.md, sections 3.1 and 17.1).
// Same mappings as default.project.json, $ignoreUnknownInstances left at its default, plus a
// Workspace with a small flat test arena, so `rojo build ci.project.json -o build/ci.rbxl` is a
// complete place with no art. Workspace settings follow section 15.4.
{
  "name": "gulp-ci",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": { "Boot": { "$path": "src/first" } },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
      // "Packages": { "$path": "Packages" } // add with the first Wally dependency
    },
    "ServerScriptService": { "Server": { "$path": "src/server" } },
    "StarterPlayer": {
      // Roblox's own Shift Lock stays off: Shift swims down (docs/02 §2.3, docs/15 §3.3)
      "$properties": { "EnableMouseLockOption": false },
      // Stub PlayerModule (docs/09, section 6.10; spike S9): no default controls or camera scripts
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" },
        "PlayerModule": { "$className": "ModuleScript", "$properties": { "Source": "--!strict\n-- Stub (docs/09, section 6.10): its presence stops Roblox inserting the default PlayerModule,\n-- so there are no default controls, touch thumbstick, jump button or camera scripts.\nreturn {}\n" } }
      }
    },
    "Players": { "$properties": { "CharacterAutoLoads": false } },
    "Lighting": {
      // 06 section 10.1: set here, never by game scripts (spike S0-A5, F22). Presets (ambient, fog,
      // grade) are written per player by TideController. Technology must be written too (task S3-A2,
      // measured): Studio derives LightingStyle and PrioritizeLightingQuality from Technology when it
      // loads a file, so with Technology absent (read as Voxel) the place came up Soft / false. Future
      // is the staff mapping of Realistic + prioritise on (PF26).
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "GlobalShadows": true,
        "ShadowSoftness": 0.8,
        "EnvironmentDiffuseScale": 0,
        "EnvironmentSpecularScale": 0,
        "GeographicLatitude": 15,
        "ClockTime": 13
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "ModelStreamingBehavior": "Improved",
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 512,
        "StreamOutBehavior": "Opportunistic",
        "AuthorityMode": "Automatic",
        "SignalBehavior": "Deferred",
        "PhysicsSteppingMethod": "Adaptive",
        "FallenPartsDestroyHeight": -5000,
        "Gravity": 80
      },
      // Test arena (docs/09, sections 3.1, 6.6 and 9.1). The floor's top is at Y = -100, so the
      // water above it is the sea. Collision is the shell (World group); Volumes holds the tagged
      // parts WorldIndex reads and destroys at start. src/server/Tests/WorldIndexSpec.luau uses them.
      "Collision": {
        "$className": "Model",
        "$properties": { "ModelStreamingMode": "Persistent" },
        "Floor": { "$className": "Part", "$properties": { "Anchored": true, "Size": [512, 4, 512], "CFrame": [0, -102, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1], "Material": "Sand", "TopSurface": "Smooth", "BottomSurface": "Smooth" } },
        // A rock 40 wide, from the floor up to Y = -40, for floorY and segmentBlocked
        "Rock": { "$className": "Part", "$properties": { "Anchored": true, "Size": [40, 60, 40], "CFrame": [60, -70, -60, 1, 0, 0, 0, 1, 0, 0, 0, 1], "Material": "Rock" } }
      },
      "Volumes": {
        "$className": "Folder",
        // Open water of the arena is reef; the Nursery ball nests inside it and wins
        "ZoneReef": { "$className": "Part", "$properties": { "Anchored": true, "Size": [512, 100, 512], "CFrame": [0, -50, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1], "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "Zone", "ZoneId": "reef" } },
        "ZoneNursery": { "$className": "Part", "$properties": { "Anchored": true, "Size": [80, 80, 80], "CFrame": [-150, -50, -150, 1, 0, 0, 0, 1, 0, 0, 0, 1], "Shape": "Ball", "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "Zone", "ZoneId": "nursery" } },
        "SafeNursery": { "$className": "Part", "$properties": { "Anchored": true, "Size": [80, 80, 80], "CFrame": [-150, -50, -150, 1, 0, 0, 0, 1, 0, 0, 0, 1], "Shape": "Ball", "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "SafeNursery" } },
        // Kelp lies beyond the arena's east edge, 64 studs clear of the reef block
        "ZoneKelp": { "$className": "Part", "$properties": { "Anchored": true, "Size": [200, 100, 200], "CFrame": [420, -50, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1], "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "Zone", "ZoneId": "kelp" } },
        // Cove 3: an upright cylinder (axis turned from X to Y), radius 15, 20 tall
        "CoveMouth3": { "$className": "Part", "$properties": { "Anchored": true, "Size": [20, 30, 30], "CFrame": [150, -50, 150, 0, -1, 0, 1, 0, 0, 0, 0, 1], "Shape": "Cylinder", "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "CoveMouth", "CoveIndex": 3 } },
        "CoveInterior3": { "$className": "Part", "$properties": { "Anchored": true, "Size": [20, 20, 20], "CFrame": [150, -50, 180, 1, 0, 0, 0, 1, 0, 0, 0, 1], "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "CoveInterior", "CoveIndex": 3 } },
        // The other 23 coves at their data:CoveMouths mouths (docs/03, section 6.7), as
        // CoveRules.volumes lays them out (the throat from the mouth plane, then the chamber; the
        // look vector toward the Reef). Cove 3 keeps the test shapes above, inside the floor, so
        // WorldIndexSpec still checks an upright cylinder. Regenerate with the snippet's rule in
        // tools/studio/place_cove_volumes.luau if the cove sizes change.
        "CoveMouth1": { "$className": "Part", "$properties": { "Anchored": true, "Size": [36, 28, 25], "CFrame": [85.596, -30, -403.228, -0.978, 0, 0.208, 0, 1, 0, -0.208, 0, -0.978], "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "CoveMouth", "CoveIndex": 1 } },
        "CoveInterior1": { "$className": "Part", "$properties": { "Anchored": true, "Size": [76, 44, 110], "CFrame": [99.612, -30, -469.256, -0.978, 0, 0.208, 0, 1, 0, -0.208, 0, -0.978], "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "CoveInterior", "CoveIndex": 1 } },
        "CoveMouth2": { "$className": "Part", "$properties": { "Anchored": true, "Size": [36, 28, 25], "CFrame": [160.879, -30, -379.509, -0.921, 0, 0.39, 0, 1, 0, -0.39, 0, -0.921], "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "CoveMouth", "CoveIndex": 2 } },
        "CoveInterior2": { "$className": "Part", "$properties": { "Anchored": true, "Size": [76, 44, 110], "CFrame": [187.223, -30, -441.655, -0.921, 0, 0.39, 0, 1, 0, -0.39, 0, -0.921], "Transparency": 1, "CanCollide": false, "CanQuery": false, "CanTouch": false, "Tags": ["Volume"] }, "$attributes": { "Kind": "CoveInterior", "CoveIndex": 2 } },
