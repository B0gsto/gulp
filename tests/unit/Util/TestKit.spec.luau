--!strict
local TestKit = require("../../../src/shared/Util/TestKit")

local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

describe("TestKit.expect", function()
	it("toBe passes on identical values and fails on different ones", function()
		expect(1 + 1).toBe(2)
		expect("krill").toBe("krill")
		expect(nil).toBe(nil)
		expect(function()
			expect(1).toBe(2)
		end).toThrow("expected 2, got 1")
		expect(function()
			expect({}).toBe({})
		end).toThrow()
	end)

	it("toEqual compares tables deeply", function()
		expect({ 1, 2, { a = "x" } }).toEqual({ 1, 2, { a = "x" } })
		expect({}).toEqual({})
		expect(function()
			expect({ a = { b = 1 } }).toEqual({ a = { b = 2 } })
		end).toThrow('value["a"]["b"]: expected 2, got 1')
	end)

	it("toEqual reports a missing key and an extra key", function()
		expect(function()
			expect({ a = 1 }).toEqual({ a = 1, b = 2 })
		end).toThrow('value["b"]: expected 2, got nil')
		expect(function()
			expect({ a = 1, b = 2 }).toEqual({ a = 1 })
		end).toThrow('value["b"]: expected nil, got 2')
	end)

	it("toEqual compares buffers by content", function()
		local a, b = buffer.create(4), buffer.create(4)
		buffer.writeu16(a, 0, 513)
		buffer.writeu16(b, 0, 513)
		expect(a).toEqual(b)
		buffer.writeu8(b, 3, 7)
		expect(function()
			expect(a).toEqual(b)
		end).toThrow("buffers differ")
	end)

	it("toBeCloseTo uses a tolerance", function()
		expect(0.1 + 0.2).toBeCloseTo(0.3)
		expect(10).toBeCloseTo(10.4, 0.5)
		expect(function()
			expect(10).toBeCloseTo(10.6, 0.5)
		end).toThrow("within 0.5")
		expect(function()
			expect(0 / 0).toBeCloseTo(0)
		end).toThrow()
		expect(function()
			expect("10").toBeCloseTo(10)
		end).toThrow()
	end)

	it("toThrow checks that a function throws, and optionally the message", function()
		expect(function()
			error("the tide is out")
		end).toThrow()
		expect(function()
			error("the tide is out")
		end).toThrow("tide")
		expect(function()
			expect(function() end).toThrow()
		end).toThrow("expected the function to throw")
		expect(function()
			expect(function()
				error("the tide is out")
			end).toThrow("shark")
		end).toThrow("expected an error containing")
		expect(function()
			expect(5).toThrow()
		end).toThrow("toThrow needs a function")
	end)
end)

describe("TestKit.run", function()
	it("counts passes and failures, names cases by their groups, then clears", function()
		-- The runner already took this file's cases out of the registry, so a nested run is safe.
		describe("outer", function()
			describe("inner", function()
				it("passes", function() end)
				it("fails", function()
					expect(1).toBe(2)
				end)
			end)
			it("throws", function()
				error("boom")
			end)
		end)
		local summary = TestKit.run()
		expect(summary.passed).toBe(1)
		expect(summary.failed).toBe(2)
		expect(summary.failures[1].name).toBe("outer > inner > fails")
		expect(summary.failures[2].name).toBe("outer > throws")
		expect(string.find(summary.failures[2].message, "boom", 1, true) ~= nil).toBe(true)

		local again = TestKit.run()
		expect(again).toEqual({ passed = 0, failed = 0, failures = {} })
	end)

	it("reports a group that throws while registering", function()
		describe("broken group", function()
			error("bad setup")
		end)
		local summary = TestKit.run()
		expect(summary.failed).toBe(1)
		expect(summary.failures[1].name).toBe("broken group (registering)")
	end)
end)

describe("TestKit.report", function()
	it("starts with PASS when nothing failed", function()
		expect(TestKit.report({ passed = 3, failed = 0, failures = {} })).toBe(
			"PASS: 3 passed, 0 failed"
		)
	end)

	it("starts with FAIL and lists each failure", function()
		local text = TestKit.report({
			passed = 1,
			failed = 1,
			failures = { { name = "a > b", message = "expected 2, got 1" } },
		})
		expect(text).toBe("FAIL: 1 passed, 1 failed\n  a > b\n    expected 2, got 1")
	end)
end)
