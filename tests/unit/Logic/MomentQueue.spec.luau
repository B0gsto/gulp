--!strict
local MomentQueue = require("../../../src/shared/Logic/MomentQueue")
local TestKit = require("../../../src/shared/Util/TestKit")

local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

local ENTER, LEAVE = MomentQueue.ENTER, MomentQueue.LEAVE

describe("MomentQueue holds (docs/08 section 4.1)", function()
	it("holds a tier-up 1,400 ms and tier 7 2,200 ms", function()
		expect(MomentQueue.tierUpHold(2, 7)).toBe(1.4)
		expect(MomentQueue.tierUpHold(6, 7)).toBe(1.4)
		expect(MomentQueue.tierUpHold(7, 7)).toBe(2.2)
	end)
	it("holds a trait 2,000 ms, Epic and Mythic 3,000 ms", function()
		expect(MomentQueue.traitHold("Common")).toBe(2)
		expect(MomentQueue.traitHold("Rare")).toBe(2)
		expect(MomentQueue.traitHold("Epic")).toBe(3)
		expect(MomentQueue.traitHold("Mythic")).toBe(3)
		expect(MomentQueue.traitHold(nil)).toBe(2)
	end)
end)

describe("MomentQueue order (docs/08 section 4.1)", function()
	it("shows one moment at a time and plays the next when it has left", function()
		local q = MomentQueue.new()
		expect(MomentQueue.push(q, "tierUp", 1.4, "a", 0)).toBe(nil)
		MomentQueue.push(q, "trait", 2, "b", 0.1)
		expect((q.current :: MomentQueue.Moment).data).toBe("a")
		local done, started = MomentQueue.step(q, ENTER + 1.4 + LEAVE - 0.01)
		expect(done).toBe(nil)
		expect(started).toBe(nil)
		done, started = MomentQueue.step(q, ENTER + 1.4 + LEAVE)
		expect((done :: MomentQueue.Moment).data).toBe("a")
		expect((started :: MomentQueue.Moment).data).toBe("b")
		expect(q.startedAt).toBeCloseTo(ENTER + 1.4 + LEAVE, 1e-9)
	end)
	it("lets a higher priority moment replace a lower one at once", function()
		local q = MomentQueue.new()
		MomentQueue.push(q, "zone", 1.5, "zone", 0)
		local replaced = MomentQueue.push(q, "tierUp", 1.4, "tier", 0.5)
		expect((replaced :: MomentQueue.Moment).data).toBe("zone")
		expect((q.current :: MomentQueue.Moment).data).toBe("tier")
		expect(q.startedAt).toBe(0.5)
		expect(#q.waiting).toBe(0) -- a replaced zone name is gone
	end)
	it("puts a replaced tier-up or trait back in the queue: they always play", function()
		local q = MomentQueue.new()
		MomentQueue.push(q, "trait", 2, "trait", 0)
		MomentQueue.push(q, "tide", 10, "tide", 0.3)
		expect(#q.waiting).toBe(1)
		expect(q.waiting[1].data).toBe("trait")
		local _, started = MomentQueue.step(q, 0.3 + ENTER + 10 + LEAVE)
		expect((started :: MomentQueue.Moment).data).toBe("trait")
	end)
	it("queues by priority, then by arrival", function()
		local q = MomentQueue.new()
		MomentQueue.push(q, "tide", 10, "tide", 0)
		MomentQueue.push(q, "zone", 1.5, "zone", 0.1)
		MomentQueue.push(q, "trait", 2, "trait1", 0.2)
		MomentQueue.push(q, "trait", 2, "trait2", 0.3)
		expect(q.waiting[1].data).toBe("trait1")
		expect(q.waiting[2].data).toBe("trait2")
		expect(q.waiting[3].data).toBe("zone")
	end)
	it("keeps three waiting, dropping the worst that may be dropped", function()
		local q = MomentQueue.new()
		MomentQueue.push(q, "tide", 10, "tide", 0)
		MomentQueue.push(q, "zone", 1.5, "zone", 0)
		MomentQueue.push(q, "eventWarning", 5, "warn", 0)
		MomentQueue.push(q, "eventStart", 2, "start", 0)
		MomentQueue.push(q, "tierUp", 1.4, "tier", 0)
		expect(#q.waiting).toBe(3)
		expect(q.waiting[1].data).toBe("tier")
		expect(q.waiting[2].data).toBe("start")
		expect(q.waiting[3].data).toBe("warn")
	end)
	it("never drops tier-ups or traits for the cap", function()
		local q = MomentQueue.new()
		MomentQueue.push(q, "tide", 10, "tide", 0)
		for i = 1, 5 do
			MomentQueue.push(q, "tierUp", 1.4, i, 0)
		end
		expect(#q.waiting).toBe(5)
	end)
	it("drops a waiting moment older than 6 s, except tier-up and trait", function()
		local q = MomentQueue.new()
		MomentQueue.push(q, "tide", 10, "tide", 0)
		MomentQueue.push(q, "zone", 1.5, "zone", 0)
		MomentQueue.push(q, "trait", 2, "trait", 0)
		-- The tide timer leaves at 10.34 s: the zone name is stale, the trait still plays.
		local _, started = MomentQueue.step(q, ENTER + 10 + LEAVE)
		expect((started :: MomentQueue.Moment).data).toBe("trait")
		local _, after = MomentQueue.step(q, ENTER + 10 + LEAVE + ENTER + 2 + LEAVE)
		expect(after).toBe(nil)
		expect(#q.waiting).toBe(0)
	end)
end)

describe("MomentQueue.pose (docs/08 section 11.3, moment slot card)", function()
	it("drops 24 rpx with a fade over 180 ms, then holds", function()
		local first = MomentQueue.pose(0, 1.4)
		expect(first.phase).toBe("enter")
		expect(first.alpha).toBe(0)
		expect(first.dy).toBeCloseTo(-24, 1e-9)
		local held = MomentQueue.pose(ENTER, 1.4)
		expect(held.phase).toBe("hold")
		expect(held.alpha).toBe(1)
		expect(held.dy).toBe(0)
	end)
	it("overshoots on the way in (Back Out)", function()
		local overshoot = false
		for i = 1, 17 do
			if MomentQueue.pose(ENTER * i / 18, 1).dy > 0 then
				overshoot = true
			end
		end
		expect(overshoot).toBe(true)
	end)
	it("fades out over 160 ms after the hold and is gone after", function()
		local mid = MomentQueue.pose(ENTER + 1.4 + LEAVE / 2, 1.4)
		expect(mid.phase).toBe("leave")
		expect(mid.alpha > 0 and mid.alpha < 1).toBe(true)
		expect(MomentQueue.pose(ENTER + 1.4 + LEAVE, 1.4).phase).toBe("gone")
	end)
	it("pops icons to 1.15 and back to 1 over 240 ms", function()
		expect(MomentQueue.popScale(0.05, 0.1)).toBe(0)
		expect(MomentQueue.popScale(0.22, 0.1)).toBeCloseTo(1.15, 1e-9)
		expect(MomentQueue.popScale(0.5, 0.1)).toBe(1)
	end)
end)
